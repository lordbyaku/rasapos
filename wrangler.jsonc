{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rasapos",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "CORE",
      "database_name": "rasapos-core",
      "database_id": "ee04fe43-cb5a-460f-81a5-b8f0f3e10a23",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "TENANT", "class_name": "TenantDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TenantDO"] }],
  // Backup harian ke R2 (03:30 WIB, simpan 35 hari)
  "r2_buckets": [{ "binding": "BACKUP", "bucket_name": "rasapos-backup" }],
  // Email reset password lewat Cloudflare Email Service: onboard domain pengirim, isi MAIL_FROM, lalu buka komentar ini.
  // "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "APP_NAME": "RasaPOS",
    "APP_URL": "https://pos.trisna.web.id",
    "SUPERADMIN_EMAILS": "haritrisna@gmail.com,na_grow@yahoo.com",
    "TRIAL_DAYS": "14",
    "GRACE_DAYS": "3",
    "OUTLETS_PER_PACK": "5",
    "PBKDF2_ITERATIONS": "60000",
    "MAIL_FROM": "",
    // Asisten panduan AI: default; API key & nilai ini bisa diatur di panel Superadmin → Asisten AI
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "AI_TENANT_DAILY": "60",
    "AI_DAILY_LIMIT": "900"
  },
  "observability": { "enabled": true },
  // 01:00 UTC = 08:00 WIB: bersihkan log lama & kirim ringkasan error ke superadmin
  "triggers": { "crons": ["0 1 * * *"] }
}
